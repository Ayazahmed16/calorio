# Copy these into your environment (or your host's settings page). Everything is optional for local development.

# --- Core (REQUIRED in production) ---
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=yourdomain.com
DJANGO_TIME_ZONE=Asia/Kolkata

# --- Email (without EMAIL_HOST, emails print to the terminal) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=you@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=1

# --- Food data ---
# Free key: https://fdc.nal.usda.gov/api-key-signup.html (DEMO_KEY is used if empty and is heavily rate limited)
USDA_API_KEY=

# --- Fitbit sync: register an app at https://dev.fitbit.com/apps ---
FITBIT_CLIENT_ID=
FITBIT_CLIENT_SECRET=

# --- Telegram reminders: create a bot with @BotFather ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
